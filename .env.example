# Public canonical site URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=

# Upcoming shows. Keep these server-side; the browser only calls /api/shows/upcoming.
BANDSINTOWN_APP_ID=
BANDSINTOWN_ARTIST=Sky Hook

# Past shows / setlists. setlist.fm requires x-api-key and attribution.
# The MBID below is Sky Hook's current public MusicBrainz ID used by setlist.fm.
SETLISTFM_API_KEY=
SETLISTFM_ARTIST_MBID=3d1204e0-b00c-4b17-80fc-e55b7f4690b0
